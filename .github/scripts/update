#!/usr/bin/env -S java --source 25

import java.io.BufferedWriter;
import java.io.OutputStreamWriter;
import java.nio.file.Files;
import java.nio.file.Path;
import java.security.MessageDigest;
import java.util.HexFormat;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.UUID;

private static final String URL = "https\\://github.com/imperiummc/resourcepack/releases/latest/download/ImperiumMC.Resource.Pack.zip";

// gh release download -R imperiummc/resourcepack --output - v2.4.5 | .github/scripts/update
void main(final String[] args) {
    final Path file = args.length > 0 ? Path.of(args[0]) : null;
    try {
        final byte[] input = file != null ? Files.readAllBytes(file) : System.in.readAllBytes();
        if (input.length == 0) {
            System.err.println("error: input is empty");
            return;
        }

        final var sha1 = MessageDigest.getInstance("SHA-1");
        final byte[] hash = sha1.digest(input);

        final var properties = properties(UUID.nameUUIDFromBytes(hash), HexFormat.of().formatHex(hash));
        try (final var writer = new BufferedWriter(new OutputStreamWriter(System.out))) {
            for (final var entry : properties.entrySet()) {
                writer.write(entry.getKey() + "=" + entry.getValue());
                writer.newLine();
            }
            writer.flush();
        }
    } catch (final Exception e) {
        System.err.printf("error: %s\n", e.getMessage());
        System.exit(1);
    }
}

private Map<String, String> properties(final UUID id, final String sha1) {
    final var properties = new LinkedHashMap<String, String>();
    properties.put("resource-pack", URL);
    properties.put("resource-pack-id", id.toString());
    properties.put("resource-pack-prompt", "");
    properties.put("resource-pack-sha1", sha1);
    return properties;
}
