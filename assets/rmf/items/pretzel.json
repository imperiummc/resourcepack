{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "type:chocolate",
        "model": {
          "type": "minecraft:model",
          "model": "rmf:item/pretzel_chocolate"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rmf:item/pretzel"
    }
  }
}
