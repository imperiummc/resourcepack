{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand",
          "thirdperson_lefthand",
          "thirdperson_righthand"
        ],
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:damaged",
          "on_true": {
            "type": "minecraft:model",
            "model": "rmf:item/shaker_cup_model_used"
          },
          "on_false": {
            "type": "minecraft:condition",
            "property": "minecraft:component",
            "predicate": "minecraft:custom_data",
            "value": {
              "rmf_canBeShaken": 1
            },
            "on_true": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_true": {
                "type": "minecraft:model",
                "model": "rmf:item/shaker_cup_model_shake"
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "rmf:item/shaker_cup_model_used"
              }
            },
            "on_false": {
              "type": "minecraft:condition",
              "property": "minecraft:has_component",
              "component": "minecraft:enchantment_glint_override",
              "on_true": {
                "type": "minecraft:model",
                "model": "rmf:item/shaker_cup_model_used"
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "rmf:item/shaker_cup_model_empty"
              }
            }
          }
        }
      },
      {
        "when": ["fixed", "on_shelf"],
        "model": {
          "type": "minecraft:model",
          "model": "rmf:item/shaker_cup_model_used"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rmf:item/shaker_cup"
    }
  }
}
