{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "size:small",
        "model": {
          "type": "minecraft:model",
          "model": "rmf:item/popcorn_bag_small"
        }
      },
      {
        "when": "size:medium",
        "model": {
          "type": "minecraft:model",
          "model": "rmf:item/popcorn_bag_medium"
        }
      },
      {
        "when": "size:large",
        "model": {
          "type": "minecraft:model",
          "model": "rmf:item/popcorn_bag_large"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rmf:item/popcorn_bag"
    }
  }
}
