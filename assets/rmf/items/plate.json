{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "on_shelf"],
        "model": {
          "type": "minecraft:model",
          "model": "rmf:item/plate"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rmf:item/plate_model"
    }
  }
}
